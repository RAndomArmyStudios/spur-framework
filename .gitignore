# Only the spur_ resources and the files named below are part of the repository.
# Everything else in this folder is left out, so a new folder never goes up unless it is added to this list.
# Custom and paid scripts live in /_custom/ and must never be added here.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/NOTICE.md
!/COPYING
!/COPYING.LESSER
!/recipe.yaml
!/server.cfg.example
!/txadmin/
!/spur_chat/
!/spur_core/
!/spur_gunny/
!/spur_loadingscreen/
!/spur_phone/
!/spur_rope/
!/spur_test/
!/spur_voice/

__pycache__/
*.pyc
*.zip
*.log
*.bak*
_forum_screens/
_custom/
